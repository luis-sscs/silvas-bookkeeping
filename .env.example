# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=silvas_accounting
DB_USER=root
DB_PASSWORD=password

# Optional single connection string (e.g., ClearDB on Heroku)
DATABASE_URL=mysql://user:password@host:3306/silvas_accounting

# Set to t`rue if your MySQL provider requires SSL
DB_SSL=false
# Set to true in non-production if you want sequelize.sync({ alter: true })
DB_SYNC=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
